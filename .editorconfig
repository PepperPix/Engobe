root = true

[*.cs]
# General formatting
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ── ReSharper / InspectCode suppressions (see ADR-008) ──
# Deliberate namespace convention: Engobe.X (not Engobe.Core.X)
resharper_check_namespace_highlighting = none
# Cosmetic only — kept as IDE hint, below the WARNING gate threshold
resharper_redundant_name_qualifier_highlighting = suggestion
resharper_redundant_using_directive_highlighting = suggestion

# Configuration DTOs use reflection-based deserialization (YamlDotNet).
[src/Engobe.Core/Configuration/*.cs]
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.S3996.severity = none
dotnet_diagnostic.S3459.severity = none
dotnet_diagnostic.S1144.severity = none
resharper_unused_auto_property_accessor_global_highlighting = none
resharper_unused_auto_property_accessor_local_highlighting = none
resharper_class_never_instantiated_global_highlighting = none
resharper_class_never_instantiated_local_highlighting = none
resharper_collection_never_updated_global_highlighting = none
resharper_collection_never_updated_local_highlighting = none

# Public model records are populated/consumed via serialization (YamlDotNet) and templates (Scriban).
[src/Engobe.Core/Models/*.cs]
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.S3996.severity = none
dotnet_diagnostic.S3459.severity = none
dotnet_diagnostic.S1144.severity = none
resharper_unused_auto_property_accessor_global_highlighting = none

# PluginLoader holds a private manifest DTO deserialized from JSON/YAML.
[src/Engobe.Core/Services/PluginLoader.cs]
dotnet_diagnostic.S3459.severity = none
dotnet_diagnostic.S1144.severity = none
resharper_unused_auto_property_accessor_local_highlighting = none
resharper_collection_never_updated_local_highlighting = none

[src/Engobe.Core/Services/NuGetPluginClient.cs]
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.S1075.severity = none

# NuGet V3 flat-container paths require lowercase package IDs and versions.
[src/Engobe.Core/Services/NuGetPluginPackageReader.cs]
dotnet_diagnostic.CA1308.severity = none

# Test fixtures intentionally include sample URLs and numeric literals for behavior verification.
[tests/**/*.cs]
dotnet_diagnostic.S109.severity = none
dotnet_diagnostic.S1075.severity = none
dotnet_diagnostic.CA2000.severity = none

# Disposal joins the fixture-owned background listener after cancelling it.
[tests/Fixtures/FakeNuGetV3Feed.cs]
dotnet_diagnostic.VSTHRD003.severity = none

# Visibility fixtures are intentionally empty, unused and instance-shaped: the tests read only their metadata.
[tests/Engobe.Core.Tests/Services/ApiSurfaceFixtures.cs]
dotnet_diagnostic.S1186.severity = none
dotnet_diagnostic.S1144.severity = none
dotnet_diagnostic.CA1822.severity = none
resharper_not_accessed_positional_property_global_highlighting = none
resharper_not_accessed_field_local_highlighting = none
resharper_unused_auto_property_accessor_global_highlighting = none

# Encoded image payload stays as raw bytes until written to disk.
[src/Engobe.Core/Services/ImageOptimizationOutput.cs]
dotnet_diagnostic.CA1819.severity = none

# Spectre.Console.Cli Settings properties are bound via reflection from CLI args.
[src/Engobe.Cli/Commands/*.cs]
resharper_unused_auto_property_accessor_global_highlighting = none

# Public API must be documented (CS1591 is an error via TreatWarningsAsErrors) ...
[src/Engobe.Abstractions/**.cs]
dotnet_diagnostic.CS1591.severity = warning

[src/Engobe.Core/**.cs]
dotnet_diagnostic.CS1591.severity = warning

# ... except concrete classes that are public for compatibility only; their members need no comments.
[src/Engobe.Core/Configuration/SiteConfigLoader.cs]
dotnet_diagnostic.CS1591.severity = none

[src/Engobe.Core/Services/{AssetReferenceIndexBuilder,ContentReader,DeploymentInitializer,DevServer,GeneratedContentSerializer,GeneratedContentWriter,MarkdownProcessor,NavigationTreeBuilder,NoOpAssetMinifier,NuGetPluginClient,NuglifyAssetMinifier,OpenApiDocGenerator,PagefindBinaryProvider,PagefindSearchIndexer,PermalinkGenerator,PluginContentHasher,PluginContentInspector,PluginLoader,PluginLockFile,PluginNames,PluginTrust,Scaffolder,ShortcodeProcessor,SiteBuilder,SkiaSharpImageOptimizer,SystemProcessRunner,TemplateRenderer,XmlDocGenerator,XmlDocParser}.cs]
dotnet_diagnostic.CS1591.severity = none
